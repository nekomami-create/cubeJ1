__pycache__/
*.pyc

# A release key, if one is ever made, is restored from a repository secret
# at build time and must never land in git. The debug keystore below is the
# exception: it is committed on purpose so that CI builds can update one
# another. See android/README.md.
*.jks
*.keystore
!android/app/debug.keystore

# Android build output (Gradle, local SDK path)
android/.gradle/
android/build/
android/app/build/
android/local.properties
