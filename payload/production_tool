#!/system/bin/sh
#
# Cube J1 auto-run setup script (local-only variant).
#
# Based on the upstream tsuyopon123/cube-j1-mqtt production_tool, with one
# addition: meter_hub.py is installed and started BEFORE mqtt_bridge.py, so
# the bridge finds its MQTT sink already listening on 127.0.0.1 and never
# enters its 15s reconnect-and-log loop.
#
# mqtt_bridge.py is this repository's fork of upstream (see payload/).

PT="/tmp/production_tool"

# -- ADB settings -------------------------------------------------------------
setprop service.adb.tcp.port 5555
setprop persist.adb.tcp.port 5555
setprop persist.sys.usb.config mtp,adb
stop adbd
sleep 1
start adbd

# -- Optional Wi-Fi survey ----------------------------------------------------
# Only when wifi_probe.sh was put on the stick. Runs before the settings below
# are reloaded, so it reports what the Cube sees from where it stands now.
[ -f $PT/wifi_probe.sh ] && sh $PT/wifi_probe.sh

# -- Wi-Fi client settings ----------------------------------------------------
cp $PT/wpa_supplicant.conf /data/misc/wifi/wpa_supplicant.conf
chmod 660 /data/misc/wifi/wpa_supplicant.conf
chown system:wifi /data/misc/wifi/wpa_supplicant.conf
wpa_cli -p /data/misc/wifi/sockets -i wlan0 reconfigure
sleep 5

# -- Install programs (persistent, survives USB removal) ----------------------
cp $PT/config.json    /data/local/config.json
# The bridge is this repository's own copy (payload/mqtt_bridge.py), forked from
# upstream 3bbb6bf. It began as sed patches applied here on the way in; once it
# also needed reply matching and meter history retrieval that stopped being
# maintainable. README "upstream differences" lists what changed and why.
cp $PT/mqtt_bridge.py /data/local/mqtt_bridge.py
cp $PT/meter_hub.py   /data/local/meter_hub.py
cp $PT/ble_monitor.py /data/local/ble_monitor.py
chmod 600 /data/local/config.json
chmod 755 /data/local/mqtt_bridge.py
chmod 755 /data/local/meter_hub.py
chmod 755 /data/local/ble_monitor.py

# make root filesystem writable so we can update init RC files
mount -o rw,remount /

# keep a copy of the stock init RC files before overwriting them. this is the
# only moment they still exist untouched. the -f guard matters: without it a
# second run would overwrite the backup with the already-disabled version.
[ -f /data/local/stock_wisund.rc ] || cp /system/etc/init/wisund.rc /data/local/stock_wisund.rc
[ -f /data/local/stock_ndeclite_agent.rc ] || cp /system/etc/init/ndeclite_agent.rc /data/local/stock_ndeclite_agent.rc
[ -f /data/local/stock_gndctrl.rc ] || cp /system/etc/init/gndctrl.rc /data/local/stock_gndctrl.rc
[ -f /data/local/stock_iptables_firewall.conf ] || cp /system/etc/iptables_firewall.conf /data/local/stock_iptables_firewall.conf
[ -f /data/local/stock_iptables_firewall.sh ] || cp /usr/sbin/iptables_firewall.sh /data/local/stock_iptables_firewall.sh
[ -f /data/local/stock_ndblued.rc ] || cp /system/etc/init/ndblued.rc /data/local/stock_ndblued.rc
[ -f /data/local/stock_blueye.rc ] || cp /system/etc/init/blueye.rc /data/local/stock_blueye.rc

# disable wisund (it holds /dev/ttyS1 and blocks our bridge)
cp $PT/wisund_disabled.rc /system/etc/init/wisund.rc

# disable ndeclite_agent (depends on wisund socket, not needed)
cp $PT/ndeclite_disabled.rc /system/etc/init/ndeclite_agent.rc

# ble_monitor owns the Bluetooth UART (/dev/ttyS0) for BLE scanning, so the
# stock Bluetooth daemons must not grab it at boot. They are unused (no cloud):
# ndblued is Bluedroid + the BLE binder API, blueye reads paired health/sensor
# devices. Disabled here, restored from stock_*.rc (see README "元に戻す").
# ble_monitor itself calls `start ndblued; start blueye` if it ever exits, so
# stopping the monitor brings the stock stack back.
cp $PT/ndblued_disabled.rc /system/etc/init/ndblued.rc
cp $PT/blueye_disabled.rc  /system/etc/init/blueye.rc
chmod 644 /system/etc/init/ndblued.rc /system/etc/init/blueye.rc

# gndctrl keeps re-creating a Wi-Fi Direct pairing AP (CubeJ-<mac>, 192.168.100.1/24)
# for a pairing that can never complete. It cannot be disabled - gndctrl is also the
# network manager that associates wlan0 at boot, and the USB auto-run trigger. So
# instead, reject every listening port on any p2p interface, in both address
# families (see the ip6tables patch just below). 8090 is kindash, the Kindle
# screen that lives in its own repository; it is listed even on a Cube that
# doesn't run it, so re-running this setup never reopens it.
sed 's|^POLICY=.*|POLICY="p2p+:5555,p2p+:8080,p2p+:8883,p2p+:80,p2p+:443,p2p+:8090"|' \
    /data/local/stock_iptables_firewall.conf > /system/etc/.fw.tmp
if [ -s /system/etc/.fw.tmp ]; then
    mv /system/etc/.fw.tmp /system/etc/iptables_firewall.conf
else
    rm -f /system/etc/.fw.tmp
fi

# The stock firewall script only ever touches iptables, but adb listens on
# ":::5555" - so every IPv4 rule above is bypassable over IPv6 link-local, and
# the pairing AP hands out an IPv6 link-local address to anyone who joins it.
# Teach the stock script to mirror the same POLICY into ip6tables. Always
# patched from the pristine backup, so re-running never stacks the edits.
sed -e 's|^    iptables --flush INPUT$|&\
    ip6tables --flush INPUT|' \
    -e 's|^\( *\)iptables \(-I INPUT .*-j REJECT\)$|\1iptables \2\
\1ip6tables \2|' \
    /data/local/stock_iptables_firewall.sh > /system/etc/.fwsh.tmp
if [ "$(wc -c < /system/etc/.fwsh.tmp)" -gt 800 ]; then
    cp /system/etc/.fwsh.tmp /usr/sbin/iptables_firewall.sh
    chmod 755 /usr/sbin/iptables_firewall.sh
fi
rm -f /system/etc/.fwsh.tmp

# install services (auto-start on next boot). init refuses a world-writable
# .rc ("skipping insecure file"), and a copy from vfat can land 0666, so force 0644.
cp $PT/meter_hub.rc      /system/etc/init/meter_hub.rc
cp $PT/mqtt_ha_bridge.rc /system/etc/init/mqtt_ha_bridge.rc
cp $PT/ble_monitor.rc    /system/etc/init/ble_monitor.rc
chmod 644 /system/etc/init/meter_hub.rc /system/etc/init/mqtt_ha_bridge.rc /system/etc/init/ble_monitor.rc

# put the root filesystem back to read-only; nothing below needs to write to it
mount -o ro,remount /

# -- Stop conflicting services ------------------------------------------------
stop wisund
stop NDEcLiteAgent
stop blueye
stop ndblued

# apply the firewall policy now rather than waiting for the next boot
/usr/sbin/iptables_firewall.sh -run
sleep 2

# -- Start the hub first, then the bridge -------------------------------------
stop meter_hub 2>/dev/null || true
sleep 1
start meter_hub
sleep 3

stop mqtt_ha_bridge 2>/dev/null || true
sleep 1
start mqtt_ha_bridge

# -- Start the BLE monitor (it takes /dev/ttyS0 from the stock daemons) --------
stop ble_monitor 2>/dev/null || true
sleep 1
start ble_monitor

# -- Finish LED (blink white) -------------------------------------------------
cp $PT/led_effect.sh /data/local/led_effect.sh
chmod 755 /data/local/led_effect.sh
/data/local/led_effect.sh blink white 10
